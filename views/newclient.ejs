<%- include('partials/header') -%>
  <div>
        <form class="profileform" action="/post/createPost" enctype="multipart/form-data" method="POST"> 
          <div class="mb-3">
            <label for="clientName" class="form-label text-xl">
                    New Client Name
            </label>
            <input type="text" id="clientName" name="clientName">
          </div>
          <div class="mb-3">
            <label for="formula" class="form-label text-xl">
              Formula
            </label>
            <textarea id="formula" name="formula">
            </textarea>
          </div>
          <div class="mb-3">
            <label for="haircutNotes" class="form-label text-xl">Hair Cut Details</label>
              <textarea id="haircutNotes" name="haircutNotes">
              </textarea>
          </div>
          <div class="mb-3">
            <label for="imgUpload">Image</label>
            <input type="file" id="imageUpload" name="file">
          </div>
          <div class="mb-3">
            <label for="sparkNotes" class="form-label text-xl">Client Spark Notes</label>
            <textarea id="sparkNotes" name="sparkNotes">
            </textarea>
          </div>
          <button type="submit" value="Upload" class="button fit">Submit</button>
        </form>
  </div>
   
  <div class="large-lock">
    <div class="logout">
      <h2>
        You are currently logged in as:
      </h2>
        <ul>
          <li>
            <b class="user-name">
            User Name:
            </b>
             <%= user.userName %>
          </li>
          <li>
            <b class="user-name">
            Email: 
            </b>
            <%= user.email %>
          </li>
          <li>
            <a href="/logout" class="button primary">
              Logout
            </a>
          </li>
        </ul>
        
    </div>
  </div>

<%- include('partials/footer') -%>